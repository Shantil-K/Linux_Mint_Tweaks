#!/bin/sh
# Bound to the G key (XF86Launch8). Steps through the boost levels in
# ~/.config/g-mode.conf and shows a notification.
# Fan speed = Dell's automatic curve + boost level (0 = automatic only).
CONF="$HOME/.config/g-mode.conf"
B=/usr/local/bin/g-fan-boost
if [ ! -f "$CONF" ]; then
    mkdir -p "$(dirname "$CONF")"
    cat > "$CONF" <<'CFG'
# G key fan boost levels, cycled in this order on each press.
# Fan speed = Dell's automatic curve + level. 0 = automatic only, 100 = maximum.
# Out-of-range values are clamped to 0-100; entries with no number are skipped.
LEVELS="0 33 66 100"
CFG
fi
LEVELS="0 33 66 100"
. "$CONF"
tag="string:x-canonical-private-synchronous:g-mode"
note() { notify-send -h "$tag" -i temperature-symbolic "$@"; }
fail() { notify-send -u critical -h "$tag" "G-Mode failed" "$1"; exit 1; }

# Clean the level list: clamp to 0-100, round, drop entries with no number, drop repeats.
clean=$(printf '%s\n' $LEVELS | awk '{
    s = $0; gsub(/%/, "", s); sub(/,/, ".", s)
    if (s !~ /^[-+]?([0-9]+(\.[0-9]*)?|\.[0-9]+)([eE][-+]?[0-9]+)?$/) next
    n = int(s + (s < 0 ? -0.5 : 0.5)); if (n < 0) n = 0; if (n > 100) n = 100
    if (!(n in seen)) { seen[n] = 1; printf "%s%d", (c++ ? " " : ""), n }
}')
[ -n "$clean" ] || clean="0 33 66 100"

cur=$($B get 2>/dev/null) || cur=$(sudo -n $B get 2>&1) || fail "$cur"
# Next level: the one after the current level in the list; if the current level
# isn't in the list, the first level above it; otherwise wrap to the first.
next=$(printf '%s\n' $clean | awk -v cur="$cur" '
    { l[NR] = $1 } END {
        for (i = 1; i <= NR; i++) if (l[i] == cur) { print l[i % NR + 1]; exit }
        for (i = 1; i <= NR; i++) if (l[i] > cur) { print l[i]; exit }
        print l[1]
    }')

out=$(sudo -n $B set "$next" 2>&1) || fail "$out"
if [ "$next" -eq 0 ]; then title="G-Mode off"; body="Automatic fan curve"
else title="G-Mode: auto + $next"; body="Automatic curve + $next of 100"; fi
note "$title" "$body"

# After the fans settle, update the same notification with their speeds.
(
    sleep 5
    st=$(sudo -n $B status 2>/dev/null) || exit 0
    [ "$(sudo -n $B get)" = "$next" ] || exit 0     # another press happened meanwhile
    rpm=${st#*rpm=}
    note "$title" "$body\nFans: ${rpm%/*} / ${rpm#*/} RPM   Levels: $clean"
) >/dev/null 2>&1 &
