def load_settings():
    s = {"accent": DEFAULT_ACCENT, "options": {k: d for k, _, _, d in OPTIONS}}
    try:
        saved = json.load(open(SETTINGS))
        s["accent"] = saved.get("accent", s["accent"])
        s["options"].update({k: v for k, v in saved.get("options", {}).items()
                             if k in s["options"]})
    except (OSError, ValueError):
        pass
    return s


def save_settings(accent, opts):
    os.makedirs(DATA_DIR, exist_ok=True)
    json.dump({"accent": accent, "options": opts}, open(SETTINGS, "w"), indent=2)

# ---------------------------------------------------------------- theme files


def snapshot_path(theme):
    return os.path.join(DATA_DIR, os.path.basename(theme.rstrip("/")) + "-original.tar.gz")


def ensure_original(theme, log):
    """Save the theme as the original unless it's already been tweaked."""
    snap = snapshot_path(theme)
    if os.path.exists(os.path.join(theme, MARKER)) and os.path.exists(snap):
        return snap
    if os.path.exists(os.path.join(theme, MARKER)):
        raise RuntimeError(
            "This theme was already changed, but its original copy is missing.\n"
            "Reinstall the theme, then apply again.")
    os.makedirs(DATA_DIR, exist_ok=True)
    with tarfile.open(snap, "w:gz") as t:
        t.add(theme, arcname=os.path.basename(theme.rstrip("/")))
    log("Saved an original copy of the theme.")
    return snap


def restore_original(theme, log):
    snap = snapshot_path(theme)
    if not os.path.exists(snap):
        raise RuntimeError("No original copy saved for this theme yet.")
    parent = os.path.dirname(theme.rstrip("/"))
    name = os.path.basename(theme.rstrip("/"))
    with tempfile.TemporaryDirectory(dir=parent) as tmp:
        with tarfile.open(snap) as t:
            if hasattr(tarfile, "data_filter"):
                t.extractall(tmp, filter="data")
            else:
                t.extractall(tmp)
        if os.path.exists(theme):
            shutil.rmtree(theme)
        shutil.move(os.path.join(tmp, name), theme)
    log("Restored the original theme.")


def gtk3_css(theme):
    for p in ("gtk-3.20/gtk.css", "gtk-3.0/gtk.css"):
        f = os.path.join(theme, p)
        if os.path.exists(f):
            return f
    raise RuntimeError("No GTK3 stylesheet found in this theme.")


WIN_BLUE_L = colorsys.rgb_to_hls(0x00 / 255, 0x78 / 255, 0xD7 / 255)[1]


def _is_blue(r, g, b):
    h, l, s = colorsys.rgb_to_hls(r / 255, g / 255, b / 255)
    return s > 0.35 and 0.5 < h < 0.72 and l > 0.08


def _recolor_fn(accent):
    """Map Windows blues to matching shades of the accent colour."""
    ar, ag, ab = (v / 255 for v in hex2rgb(accent))
    ah, al, as_ = colorsys.rgb_to_hls(ar, ag, ab)
    exact = hex2rgb(accent)

    def to_accent(r, g, b):
        if (r, g, b) == (0x00, 0x78, 0xD7):  # Windows accent blue
            return exact
        h, l, s = colorsys.rgb_to_hls(r / 255, g / 255, b / 255)
        l2 = max(0.04, min(0.96, l + (al - WIN_BLUE_L)))
        return tuple(round(v * 255) for v in colorsys.hls_to_rgb(ah, l2, s * as_))
    return to_accent


def recolor_accent(theme, accent, log):
    to_accent = _recolor_fn(accent)

    def hexsub(m):
        h = m.group(1)
        r, g, b = (int(h[i:i + 2], 16) for i in (0, 2, 4))
        return rgb2hex(to_accent(r, g, b)) if _is_blue(r, g, b) else m.group(0)

    def rgbsub(m):
        r, g, b = map(int, m.groups()[1:4])
        if not _is_blue(r, g, b):
            return m.group(0)
        return "%s(%d, %d, %d" % (m.group(1), *to_accent(r, g, b))

    def extras(css):
        # Progress bars and full level bars use a fixed Windows green;
        # switch them to the accent too (but keep the "success" colour).
        css = re.sub(r"(?im)^(?!\s*@define-color).*#06B025.*$",
                     lambda m: m.group(0).replace("#06B025", accent).replace("#06b025", accent),
                     css)
        return css.replace("#0d9726", shade(accent, -0.06))

    try:
        from PIL import Image
    except ImportError:
        Image = None
        log("Pillow not installed: images stay blue.")

    n = 0
    for d in ("gtk-2.0", "gtk-3.0", "gtk-3.20", "gtk-4.0"):
        for f in glob.glob(os.path.join(theme, d, "**", "*"), recursive=True):
            if f.endswith((".css", ".svg", "gtkrc")):
                s = open(f, encoding="utf-8", errors="surrogateescape").read()
                t = re.sub(r"#([0-9a-fA-F]{6})\b", hexsub, s)
                t = re.sub(r"(rgba?)\(\s*(\d+)\s*,\s*(\d+)\s*,\s*(\d+)", rgbsub, t)
                if f.endswith(".css"):
                    t = extras(t)
                if t != s:
                    open(f, "w", encoding="utf-8", errors="surrogateescape").write(t)
                    n += 1
            elif f.endswith(".png") and Image:
                im = Image.open(f).convert("RGBA")
                px = im.load()
                changed = False
                for y in range(im.height):
                    for x in range(im.width):
                        r, g, b, a = px[x, y]
                        if a and _is_blue(r, g, b):
                            px[x, y] = (*to_accent(r, g, b), a)
                            changed = True
                if changed:
                    im.save(f)
                    n += 1
    log(f"Recoloured {n} files to {accent_name(accent)}.")


def dark_checkboxes(theme, accent, log):
    """Redraw checkbox and radio images: dark fill, grey border, accent mark."""
    try:
        from PIL import Image, ImageDraw
    except ImportError:
        log("Pillow not installed: checkboxes not changed.")
        return
    BG = (32, 32, 32)
    BORDER, BORDER_HOVER, BORDER_OFF = (140, 140, 140), (206, 206, 206), (77, 77, 77)
    MARK = hex2rgb(accent)
    MARK_OFF = hex2rgb(mix(accent, "#202020", 0.55))
    SS = 8  # draw large, then shrink for smooth edges

    def draw(size, border, mark, mark_color, round_=False):
        k = size / 13 * SS
        im = Image.new("RGBA", (size * SS, size * SS), (0, 0, 0, 0))
        d = ImageDraw.Draw(im)
        box = [0, 0, size * SS - 1, size * SS - 1]
        w = max(1, round(size / 13)) * SS
        if round_:
            d.ellipse(box, fill=BG + (255,), outline=border + (255,), width=w)
        else:
            d.rectangle(box, fill=BG + (255,))
            d.rectangle(box, outline=border + (255,), width=w)
        if mark == "dot":
            d.ellipse([3.5 * k, 3.5 * k, 9.5 * k, 9.5 * k], fill=mark_color + (255,))
        elif mark == "tick":
            d.line([(2.8 * k, 6.6 * k), (5.3 * k, 9.1 * k), (10.2 * k, 3.9 * k)],
                   fill=mark_color + (255,), width=round(1.7 * k), joint="curve")
        elif mark == "dash":
            d.line([(3.5 * k, 6.5 * k), (9.5 * k, 6.5 * k)],
                   fill=mark_color + (255,), width=round(2 * k))
        return im.resize((size, size), Image.LANCZOS)

    n = 0
    for d in ("gtk-3.0", "gtk-3.20", "gtk-4.0"):
        files = (glob.glob(os.path.join(theme, d, "**", "checkbox-*.png"), recursive=True)
                 + glob.glob(os.path.join(theme, d, "**", "radio-*.png"), recursive=True))
        for f in files:
            name = os.path.basename(f)
            size = Image.open(f).size[0]
            radio = name.startswith("radio-")
            if "-checked" in name:
                mark = "dot" if radio else "tick"
            else:
                mark = "dash" if "-mixed" in name else None
            if "insensitive" in name:
                border, color = BORDER_OFF, MARK_OFF
            elif "-over" in name or "-active" in name:
                border, color = BORDER_HOVER, MARK
            else:
                border, color = BORDER, MARK
            draw(size, border, mark, color, radio).save(f)
            n += 1
    log(f"Redrew {n} checkbox and radio images.")


def set_force_theme(name, enabled, log):
    """Add or remove GTK_THEME in ~/.profile and environment.d."""
    tag = "# win10-theme-tweaks"
    lines = open(PROFILE).read().splitlines() if os.path.exists(PROFILE) else []
    lines = [l for l in lines if tag not in l
             and not re.match(r"\s*export GTK_THEME=", l)
             and l.strip() != "# Force the GTK theme for every app"]
    if enabled:
        lines.append(f"export GTK_THEME={name}  {tag}")
    open(PROFILE, "w").write("\n".join(lines) + "\n")
    if enabled:
        os.makedirs(os.path.dirname(ENV_FILE), exist_ok=True)
        open(ENV_FILE, "w").write(f"GTK_THEME={name}\n")
    elif os.path.exists(ENV_FILE):
        os.remove(ENV_FILE)
    log("Every app will use this theme after you log out and back in." if enabled
        else "Apps will follow the normal theme setting after you log out and back in.")


def reload_gtk_theme(name):
    for schema in ("org.cinnamon.desktop.interface", "org.gnome.desktop.interface"):
        subprocess.run(["gsettings", "set", schema, "gtk-theme", "Adwaita"], check=False)
    subprocess.run(["sleep", "1"])
    for schema in ("org.cinnamon.desktop.interface", "org.gnome.desktop.interface"):
        subprocess.run(["gsettings", "set", schema, "gtk-theme", name], check=False)


def restart_cinnamon(log):
    if "cinnamon" not in os.environ.get("XDG_CURRENT_DESKTOP", "").lower():
        log("Not running Cinnamon; skipped restart.")
        return
    subprocess.Popen(["cinnamon", "--replace"], start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    log("Restarting Cinnamon…")


def apply(theme, opts, accent=DEFAULT_ACCENT, log=print):
    theme = os.path.abspath(theme)
    name = os.path.basename(theme)
    if not os.path.isdir(theme):
        raise RuntimeError(f"Theme folder not found: {theme}")
    ensure_original(theme, log)
    restore_original(theme, log)

    if opts.get("accent"):
        recolor_accent(theme, accent, log)
    if opts.get("checkbox"):
        dark_checkboxes(theme, accent, log)
    css = ""
    if opts.get("greybuttons"):
        css += CSS_GREY_BUTTONS
    if opts.get("titlebar"):
        css += CSS_TITLEBAR
    if opts.get("flat"):
        css += CSS_FLAT_BUTTONS
    if opts.get("checkbox"):
        css += CSS_DARK_CONTROLS
    if opts.get("accentbutton"):
        css += CSS_ACCENT_BUTTON
    if opts.get("nofocus"):
        css += CSS_NO_FOCUS
    if css:
        with open(gtk3_css(theme), "a") as f:
            f.write("\n/* ===== win10-theme-tweaks ===== */\n" + fill(css, accent))
        log("Added style tweaks.")
    open(os.path.join(theme, MARKER), "w").write(
        accent + " " + " ".join(k for k, v in opts.items() if v) + "\n")

    set_force_theme(name, bool(opts.get("force")), log)
    reload_gtk_theme(name)
    log("Done. Reopen apps to see the changes.")
    if opts.get("restart"):
        restart_cinnamon(log)


def restore(theme, log=print):
    theme = os.path.abspath(theme)
    restore_original(theme, log)
    set_force_theme(os.path.basename(theme), False, log)
    reload_gtk_theme(os.path.basename(theme))
    log("Original theme restored. Reopen apps to see it.")

