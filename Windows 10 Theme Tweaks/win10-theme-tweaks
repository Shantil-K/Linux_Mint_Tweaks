#!/usr/bin/env python3
"""Windows 10 Theme Tweaks

Applies a set of tweaks to the Windows-10-Dark GTK theme on Linux Mint
Cinnamon, always starting from an untouched copy of the theme:

  - Title bar buttons fill to the window corners (32px title bars)
  - Mint green accent instead of Windows blue
  - Flat buttons in title bars (no border box)
  - Mint green main action buttons (e.g. "Take Screenshot")
  - No dashed focus outline
  - Force the theme on every app (even ones that switch in dark mode)

The first time it sees a theme folder without its marker file, it saves a
copy of that folder as the "original". Every Apply restores that original
and then applies the selected tweaks, so applying twice is safe. If the
theme is reinstalled or updated (marker gone), the new copy becomes the
original.

Run without arguments for the window, or with --apply / --restore for the
command line.
"""

import colorsys
import glob
import os
import re
import shutil
import subprocess
import sys
import tarfile
import tempfile

HOME = os.path.expanduser("~")
DEFAULT_THEME = os.path.join(HOME, ".themes", "Windows-10-Dark")
DATA_DIR = os.path.join(HOME, ".local", "share", "win10-theme-tweaks")
MARKER = ".win10-tweaks-applied"
PROFILE = os.path.join(HOME, ".profile")
ENV_FILE = os.path.join(HOME, ".config", "environment.d", "90-gtk-theme.conf")
MINT_GREEN = "#35A854"

# ---------------------------------------------------------------- tweaks

