# ---------------------------------------------------------------- colours


def hex2rgb(h):
    h = h.lstrip("#")
    return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))


def rgb2hex(c):
    return "#%02X%02X%02X" % tuple(max(0, min(255, round(v))) for v in c)


def shade(hexcol, dl):
    """Lighten (dl > 0) or darken (dl < 0) a colour."""
    r, g, b = (v / 255 for v in hex2rgb(hexcol))
    h, l, s = colorsys.rgb_to_hls(r, g, b)
    return rgb2hex(v * 255 for v in colorsys.hls_to_rgb(h, max(0, min(1, l + dl)), s))


def mix(a, b, t):
    """Blend colour a toward b by t (0..1)."""
    a, b = hex2rgb(a), hex2rgb(b)
    return rgb2hex(a[i] + (b[i] - a[i]) * t for i in range(3))


def text_on(hexcol):
    """White or near-black text, whichever reads better on this colour."""
    r, g, b = (v / 255 for v in hex2rgb(hexcol))
    lum = 0.2126 * r + 0.7152 * g + 0.0722 * b
    return "#1A1A1A" if lum > 0.6 else "#FFFFFF"


def accent_tokens(accent):
    return {
        "@ACCENT@": accent,
        "@ACCENT_HOVER@": shade(accent, 0.06),
        "@ACCENT_ACTIVE@": shade(accent, -0.06),
        "@ACCENT_BAR@": shade(accent, -0.06),
        "@ACCENT_TEXT@": text_on(accent),
        "@ACCENT_DIM@": mix(accent, "#202020", 0.55),
    }


def fill(css, accent):
    for k, v in accent_tokens(accent).items():
        css = css.replace(k, v)
    return css


def accent_name(accent):
    return next((n for n, c in ACCENTS if c.upper() == accent.upper()), accent.upper())

