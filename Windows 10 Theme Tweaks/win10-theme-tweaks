def dark_checkboxes(theme, log):
    """Redraw checkbox and radio images: dark fill, grey border, green mark."""
    try:
        from PIL import Image, ImageDraw
    except ImportError:
        log("Pillow not installed: checkboxes not changed.")
        return
    BG, GREEN = (32, 32, 32), (53, 168, 84)
    BORDER, BORDER_HOVER, BORDER_OFF = (140, 140, 140), (206, 206, 206), (77, 77, 77)
    GREEN_OFF = (52, 92, 63)
    SS = 8  # draw large, then shrink for smooth edges

    def draw(size, border, mark, mark_color, round_=False):
        k = size / 13 * SS
        im = Image.new("RGBA", (size * SS, size * SS), (0, 0, 0, 0))
        d = ImageDraw.Draw(im)
        box = [0, 0, size * SS - 1, size * SS - 1]
        w = max(1, round(size / 13)) * SS
        if round_:
            d.ellipse(box, fill=BG + (255,), outline=border + (255,), width=w)
        else:
            d.rectangle(box, fill=BG + (255,))
            d.rectangle(box, outline=border + (255,), width=w)
        if mark == "dot":
            d.ellipse([3.5 * k, 3.5 * k, 9.5 * k, 9.5 * k], fill=mark_color + (255,))
        elif mark == "tick":
            d.line([(2.8 * k, 6.6 * k), (5.3 * k, 9.1 * k), (10.2 * k, 3.9 * k)],
                   fill=mark_color + (255,), width=round(1.7 * k), joint="curve")
        elif mark == "dash":
            d.line([(3.5 * k, 6.5 * k), (9.5 * k, 6.5 * k)],
                   fill=mark_color + (255,), width=round(2 * k))
        return im.resize((size, size), Image.LANCZOS)

    n = 0
    for d in ("gtk-3.0", "gtk-3.20", "gtk-4.0"):
        files = (glob.glob(os.path.join(theme, d, "**", "checkbox-*.png"), recursive=True)
                 + glob.glob(os.path.join(theme, d, "**", "radio-*.png"), recursive=True))
        for f in files:
            name = os.path.basename(f)
            size = Image.open(f).size[0]
            radio = name.startswith("radio-")
            if "-checked" in name:
                mark = "dot" if radio else "tick"
            else:
                mark = "dash" if "-mixed" in name else None
            if "insensitive" in name:
                border, color = BORDER_OFF, GREEN_OFF
            elif "-over" in name or "-active" in name:
                border, color = BORDER_HOVER, GREEN
            else:
                border, color = BORDER, GREEN
            draw(size, border, mark, color, radio).save(f)
            n += 1
    log(f"Redrew {n} checkbox and radio images.")


def apply(theme, opts, log=print):
    theme = os.path.abspath(theme)
    name = os.path.basename(theme)
    if not os.path.isdir(theme):
        raise RuntimeError(f"Theme folder not found: {theme}")
    ensure_original(theme, log)
    restore_original(theme, log)

    if opts.get("green"):
        recolor_green(theme, log)
    if opts.get("checkbox"):
        dark_checkboxes(theme, log)
    css = ""
    if opts.get("titlebar"):
        css += CSS_TITLEBAR
    if opts.get("flat"):
        css += CSS_FLAT_BUTTONS
    if opts.get("checkbox"):
        css += CSS_DARK_CONTROLS
    if opts.get("greenbutton"):
        css += CSS_GREEN_BUTTON
    if opts.get("nofocus"):
        css += CSS_NO_FOCUS
    if css:
        with open(gtk3_css(theme), "a") as f:
            f.write("\n/* ===== win10-theme-tweaks ===== */\n" + css)
        log("Added style tweaks.")
    open(os.path.join(theme, MARKER), "w").write(
        " ".join(k for k, v in opts.items() if v) + "\n")

    set_force_theme(name, bool(opts.get("force")), log)
    reload_gtk_theme(name)
    log("Done. Reopen apps to see the changes.")
    if opts.get("restart"):
        restart_cinnamon(log)


def restore(theme, log=print):
    theme = os.path.abspath(theme)
    restore_original(theme, log)
    set_force_theme(os.path.basename(theme), False, log)
    reload_gtk_theme(os.path.basename(theme))
    log("Original theme restored. Reopen apps to see it.")

# ---------------------------------------------------------------- window


def run_gui():
    import gi
    gi.require_version("Gtk", "3.0")
    from gi.repository import Gtk, GLib

    win = Gtk.Window(title="Windows 10 Theme Tweaks")
    win.set_default_size(460, -1)
    win.set_border_width(16)
    win.connect("destroy", Gtk.main_quit)

    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
    win.add(box)

    row = Gtk.Box(spacing=8)
    row.pack_start(Gtk.Label(label="Theme folder", xalign=0), False, False, 0)
    chooser = Gtk.FileChooserButton(title="Choose theme folder",
                                    action=Gtk.FileChooserAction.SELECT_FOLDER)
    if os.path.isdir(DEFAULT_THEME):
        chooser.set_filename(DEFAULT_THEME)
    else:
        chooser.set_current_folder(os.path.join(HOME, ".themes"))
    row.pack_start(chooser, True, True, 0)
    box.pack_start(row, False, False, 0)

    checks = {}
    for key, label, desc, default in OPTIONS:
        cb = Gtk.CheckButton()
        lbl = Gtk.Label(xalign=0)
        lbl.set_markup(f"{GLib.markup_escape_text(label)}\n"
                       f"<small>{GLib.markup_escape_text(desc)}</small>")
        lbl.set_line_wrap(True)
        cb.add(lbl)
        cb.set_active(default)
        checks[key] = cb
        box.pack_start(cb, False, False, 0)

    status = Gtk.Label(xalign=0)
    status.set_line_wrap(True)
    status.set_selectable(True)
    box.pack_start(status, False, False, 4)

    buttons = Gtk.Box(spacing=8)
    restore_btn = Gtk.Button(label="Restore original")
    apply_btn = Gtk.Button(label="Apply")
    apply_btn.get_style_context().add_class("suggested-action")
    buttons.pack_end(apply_btn, False, False, 0)
    buttons.pack_end(restore_btn, False, False, 0)
    box.pack_end(buttons, False, False, 0)

    messages = []

    def log(msg):
        messages.append(msg)
        status.set_text("\n".join(messages))
        while Gtk.events_pending():
            Gtk.main_iteration()

    def run(fn):
        messages.clear()
        theme = chooser.get_filename()
        if not theme:
            log("Choose a theme folder first.")
            return
        apply_btn.set_sensitive(False)
        restore_btn.set_sensitive(False)
        try:
            fn(theme)
        except Exception as e:  # show any problem in the window
            log(f"Error: {e}")
        apply_btn.set_sensitive(True)
        restore_btn.set_sensitive(True)

    apply_btn.connect("clicked", lambda *_: run(
        lambda t: apply(t, {k: c.get_active() for k, c in checks.items()}, log)))
    restore_btn.connect("clicked", lambda *_: run(lambda t: restore(t, log)))

    win.show_all()
    Gtk.main()


if __name__ == "__main__":
    args = sys.argv[1:]
    theme = next((a for a in args if not a.startswith("--")), DEFAULT_THEME)
    if "--apply" in args:
        apply(theme, {k: d for k, _, _, d in OPTIONS if not (k == "restart" and "--no-restart" in args)})
    elif "--restore" in args:
        restore(theme)
    else:
        run_gui()
