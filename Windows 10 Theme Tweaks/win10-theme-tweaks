def preview_gtk4():
    import gi
    gi.require_version("Gtk", "4.0")
    gi.require_version("Adw", "1")
    from gi.repository import Gtk, Adw

    def vbox(spacing=8):
        return Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=spacing)

    def row(*ws, spacing=8):
        b = Gtk.Box(spacing=spacing)
        for w in ws:
            b.append(w)
        return b

    def btn(label, cls=None, sensitive=True):
        b = Gtk.Button(label=label)
        b.set_sensitive(sensitive)
        if cls:
            b.add_css_class(cls)
        return b

    def section(title, *children):
        box = vbox()
        h = Gtk.Label(xalign=0)
        h.set_markup(f"<b>{title}</b>")
        box.append(h)
        for c in children:
            box.append(c)
        return box

    def check(label, active=False, inconsistent=False, sensitive=True, group=None):
        c = Gtk.CheckButton(label=label)
        if group:
            c.set_group(group)
        c.set_active(active)
        c.set_inconsistent(inconsistent)
        c.set_sensitive(sensitive)
        return c

    def switch(active, sensitive=True):
        s = Gtk.Switch(active=active, sensitive=sensitive)
        s.set_valign(Gtk.Align.CENTER)
        return s

    def build(app):
        toggle = Gtk.ToggleButton(label="Toggle (on)", active=True)
        linked = row(btn("Left"), btn("Middle"), btn("Right"), spacing=0)
        linked.add_css_class("linked")
        buttons = section(
            "Buttons",
            row(btn("Normal"), btn("Disabled", sensitive=False), btn("Flat", "flat")),
            row(btn("Suggested", "suggested-action"), btn("Destructive", "destructive-action"),
                btn("Pill", "pill")),
            row(toggle, linked, Gtk.Button(icon_name="edit-copy-symbolic"),
                Gtk.LinkButton(uri="https://linuxmint.com", label="Link")))

        r1 = check("Radio (on)", True)
        r2 = check("Radio (off)", group=r1)
        r3 = check("Disabled", group=r1, sensitive=False)
        choices = section(
            "Checkboxes, radio buttons and switches",
            row(check("Checked", True), check("Unchecked"), check("Mixed", inconsistent=True)),
            row(check("Disabled on", True, sensitive=False),
                check("Disabled off", sensitive=False)),
            row(r1, r2, r3),
            row(switch(True), Gtk.Label(label="On"), switch(False), Gtk.Label(label="Off"),
                switch(True, False), Gtk.Label(label="Disabled")))

        inputs = section(
            "Text and choices",
            row(Gtk.Entry(text="Text entry"), Gtk.Entry(placeholder_text="Placeholder text"),
                Gtk.Entry(text="Disabled", sensitive=False)),
            row(Gtk.SpinButton.new_with_range(0, 100, 1),
                Gtk.DropDown.new_from_strings(["Dropdown", "Option 2", "Option 3"])))

        scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
        scale.set_value(60)
        scale.set_size_request(260, -1)
        sliders = section("Sliders and progress", scale,
                          Gtk.ProgressBar(fraction=0.6, show_text=True),
                          Gtk.LevelBar(value=0.6), row(Gtk.Spinner(spinning=True)))

        lb = Gtk.ListBox()
        lb.add_css_class("boxed-list")
        r = Adw.ActionRow(title="Action row", subtitle="With a switch")
        r.add_suffix(switch(True))
        lb.append(r)
        r = Adw.ActionRow(title="Another row", subtitle="With a button")
        b = btn("Button")
        b.set_valign(Gtk.Align.CENTER)
        r.add_suffix(b)
        lb.append(r)
        er = Adw.ExpanderRow(title="Expander row", subtitle="Click to open")
        er.add_row(Adw.ActionRow(title="Inside the expander"))
        lb.append(er)

        plain = Gtk.ListBox()
        for t in ("Selected row", "Row", "Row"):
            plain.append(Gtk.Label(label=t, xalign=0, margin_top=6, margin_bottom=6,
                                   margin_start=6))
        plain.select_row(plain.get_row_at_index(0))

        nb = Gtk.Notebook()
        for t in ("Tab one", "Tab two", "Tab three"):
            nb.append_page(Gtk.Label(label=f"{t} content", margin_top=12, margin_bottom=12),
                           Gtk.Label(label=t))
        lists = section("Lists and tabs", lb, plain, nb)

        sel = Gtk.HeaderBar()
        sel.add_css_class("selection-mode")
        sel.pack_start(Gtk.Button(label="Cancel"))
        sel.set_title_widget(Gtk.Label(label="Selection mode bar"))
        sel.set_show_title_buttons(False)
        banner = Adw.Banner(title="A banner message", button_label="Action", revealed=True)
        exp = Gtk.Expander(label="Expander", child=Gtk.Label(label="Hidden content", xalign=0))
        bars = section("Messages and bars", banner, exp, sel)

        left, right = vbox(20), vbox(20)
        for w in (buttons, choices, inputs, sliders):
            left.append(w)
        for w in (lists, bars):
            right.append(w)
        cols = Gtk.Box(spacing=32, margin_top=20, margin_bottom=20,
                       margin_start=20, margin_end=20, homogeneous=True)
        cols.append(left)
        cols.append(right)
        scroll = Gtk.ScrolledWindow(child=cols, vexpand=True)

        title = "Theme preview: GTK4 + libadwaita"
        hb = Adw.HeaderBar(title_widget=Gtk.Label(label=title))
        hb.pack_start(btn("Open"))
        hb.pack_end(Gtk.MenuButton(icon_name="open-menu-symbolic"))
        hb.pack_end(btn("Save", "suggested-action"))
        content = vbox(0)
        content.append(hb)
        content.append(scroll)
        win = Adw.ApplicationWindow(application=app, title=title, content=content)
        win.set_default_size(1000, 760)
        win.present()

    app = Adw.Application(application_id="org.win10tweaks.Preview4")
    app.connect("activate", build)
    app.run([])


def launch_preview(kind, theme_name):
    env = dict(os.environ, GTK_THEME=theme_name)
    subprocess.Popen([sys.executable, os.path.abspath(__file__), "--preview", kind],
                     env=env, start_new_session=True)

