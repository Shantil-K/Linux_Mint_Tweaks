def run_gui():
    import gi
    gi.require_version("Gtk", "3.0")
    from gi.repository import Gtk, Gdk, GLib

    GLib.set_prgname("win10-theme-tweaks")
    GLib.set_application_name("Windows 10 Theme Tweaks")
    settings = load_settings()
    state = {"accent": settings["accent"]}

    win = Gtk.Window(title="Windows 10 Theme Tweaks")
    win.set_default_size(520, 640)
    win.connect("destroy", Gtk.main_quit)

    stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE)
    switcher = Gtk.StackSwitcher(stack=stack)
    hb = Gtk.HeaderBar(show_close_button=True)
    hb.set_custom_title(switcher)
    win.set_titlebar(hb)

    outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
    outer.pack_start(stack, True, True, 0)
    win.add(outer)

    def page():
        b = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, margin=16)
        return b

    # ---- Tweaks page
    tweaks = page()
    row = Gtk.Box(spacing=8)
    row.pack_start(Gtk.Label(label="Theme folder", xalign=0), False, False, 0)
    chooser = Gtk.FileChooserButton(title="Choose theme folder",
                                    action=Gtk.FileChooserAction.SELECT_FOLDER)
    if os.path.isdir(DEFAULT_THEME):
        chooser.set_filename(DEFAULT_THEME)
    else:
        chooser.set_current_folder(os.path.join(HOME, ".themes"))
    row.pack_start(chooser, True, True, 0)
    tweaks.pack_start(row, False, False, 0)

    checks = {}
    for key, label, desc, default in OPTIONS:
        cb = Gtk.CheckButton()
        lbl = Gtk.Label(xalign=0)
        lbl.set_markup(f"{GLib.markup_escape_text(label)}\n"
                       f"<small>{GLib.markup_escape_text(desc)}</small>")
        lbl.set_line_wrap(True)
        cb.add(lbl)
        cb.set_active(settings["options"].get(key, default))
        checks[key] = cb
        tweaks.pack_start(cb, False, False, 0)
    scroll = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
    scroll.add(tweaks)
    stack.add_titled(scroll, "tweaks", "Tweaks")

    # ---- Accent page
    accent_page = page()
    intro = Gtk.Label(xalign=0, wrap=True,
                      label="Choose the colour that replaces Windows blue. "
                            "It's used for selections, switches, sliders, "
                            "checkbox ticks and main buttons.")
    accent_page.pack_start(intro, False, False, 0)

    css = Gtk.CssProvider()
    rules = [".swatch { border-radius: 50%; min-width: 40px; min-height: 40px; "
             "border: 2px solid transparent; }",
             "radiobutton.swatch-btn:checked .swatch, button.swatch-btn:checked .swatch "
             "{ border-color: #FFFFFF; }",
             ".swatch-btn { padding: 6px; }"]
    for i, (_, c) in enumerate(ACCENTS):
        rules.append(f".swatch-{i} {{ background-color: {c}; }}")
    css.load_from_data("\n".join(rules).encode())
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), css,
                                             Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    flow = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, max_children_per_line=5,
                       min_children_per_line=5, column_spacing=8, row_spacing=8)
    chosen = Gtk.Label(xalign=0)
    custom_btn = Gtk.ColorButton()
    radios = []
    group = None

    def show_chosen():
        a = state["accent"]
        chosen.set_markup(f"Selected: <b>{GLib.markup_escape_text(accent_name(a))}</b> "
                          f"<span foreground='{a}'>●</span> {a.upper()}")

    def pick(color):
        state["accent"] = color.upper()
        show_chosen()

    for i, (name, color) in enumerate(ACCENTS):
        rb = Gtk.RadioButton.new_from_widget(group)
        group = group or rb
        rb.set_mode(False)  # look like a button, not a radio circle
        rb.get_style_context().add_class("swatch-btn")
        rb.get_style_context().add_class("flat")
        inner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        dot = Gtk.Box()
        dot.get_style_context().add_class("swatch")
        dot.get_style_context().add_class(f"swatch-{i}")
        dot.set_halign(Gtk.Align.CENTER)
        inner.pack_start(dot, False, False, 0)
        inner.pack_start(Gtk.Label(label=name), False, False, 0)
        rb.add(inner)
        rb.connect("toggled", lambda b, c=color: b.get_active() and pick(c))
        radios.append((rb, color))
        flow.add(rb)
    custom_radio = Gtk.RadioButton.new_from_widget(group)
    custom_radio.set_no_show_all(True)  # hidden: selected when a custom colour is used
    accent_page.pack_start(flow, False, False, 0)

    crow = Gtk.Box(spacing=8)
    crow.pack_start(Gtk.Label(label="Custom colour"), False, False, 0)
    crow.pack_start(custom_btn, False, False, 0)
    accent_page.pack_start(crow, False, False, 0)
    accent_page.pack_start(chosen, False, False, 8)

    def on_custom(b):
        rgba = b.get_rgba()
        custom_radio.set_active(True)
        pick(rgb2hex((rgba.red * 255, rgba.green * 255, rgba.blue * 255)))
    custom_btn.connect("color-set", on_custom)

    match = next((rb for rb, c in radios if c.upper() == state["accent"].upper()), None)
    if match:
        match.set_active(True)
    else:
        custom_radio.set_active(True)
    rgba = Gdk.RGBA()
    rgba.parse(state["accent"])
    custom_btn.set_rgba(rgba)
    show_chosen()
    note = Gtk.Label(xalign=0, wrap=True)
    note.set_markup("<small>Press Apply on the Tweaks tab (or below) to use the new colour.</small>")
    accent_page.pack_start(note, False, False, 0)
    stack.add_titled(accent_page, "accent", "Accent")

    # ---- Preview page
    prev = page()
    prev.pack_start(Gtk.Label(
        xalign=0, wrap=True,
        label="Open a window with every kind of button and control, drawn with "
              "the theme in the folder chosen on the Tweaks tab. Mint has three "
              "kinds of apps, each styled a little differently:"), False, False, 0)
    for kind, title, desc, libs in PREVIEWS:
        r = Gtk.Box(spacing=12)
        txt = Gtk.Label(xalign=0, wrap=True)
        txt.set_markup(f"{GLib.markup_escape_text(title)}\n<small>{GLib.markup_escape_text(desc)}</small>")
        r.pack_start(txt, True, True, 0)
        missing = [l for l in libs if not has_typelib(l)]
        b = Gtk.Button(label="Open preview")
        b.set_valign(Gtk.Align.CENTER)
        if missing:
            b.set_sensitive(False)
            pk = {"Gtk-4.0": "gir1.2-gtk-4.0", "Adw-1": "gir1.2-adw-1",
                  "Handy-1": "gir1.2-handy-1", "Gtk-3.0": "gir1.2-gtk-3.0"}
            txt.set_markup(txt.get_label() + "\n<small>Needs: <tt>sudo apt install "
                           + " ".join(pk[m] for m in missing) + "</tt></small>")
            txt.set_selectable(True)
        b.connect("clicked", lambda _b, k=kind: launch_preview(
            k, os.path.basename((chooser.get_filename() or DEFAULT_THEME).rstrip("/"))))
        r.pack_start(b, False, False, 0)
        prev.pack_start(r, False, False, 6)
    stack.add_titled(prev, "preview", "Preview")

    # ---- Status and buttons (shared by all pages)
    status = Gtk.Label(xalign=0, wrap=True, selectable=True, margin_start=16, margin_end=16)
    outer.pack_start(status, False, False, 4)
    buttons = Gtk.Box(spacing=8, margin=16)
    restore_btn = Gtk.Button(label="Restore original")
    apply_btn = Gtk.Button(label="Apply")
    apply_btn.get_style_context().add_class("suggested-action")
    buttons.pack_end(apply_btn, False, False, 0)
    buttons.pack_end(restore_btn, False, False, 0)
    outer.pack_start(buttons, False, False, 0)

    messages = []

    def log(msg):
        messages.append(msg)
        status.set_text("\n".join(messages))
        while Gtk.events_pending():
            Gtk.main_iteration()

    def run(fn):
        messages.clear()
        theme = chooser.get_filename()
        if not theme:
            log("Choose a theme folder first.")
            return
        apply_btn.set_sensitive(False)
        restore_btn.set_sensitive(False)
        try:
            fn(theme)
        except Exception as e:  # show any problem in the window
            log(f"Error: {e}")
        apply_btn.set_sensitive(True)
        restore_btn.set_sensitive(True)

    def do_apply(theme):
        opts = {k: c.get_active() for k, c in checks.items()}
        save_settings(state["accent"], opts)
        apply(theme, opts, state["accent"], log)

    apply_btn.connect("clicked", lambda *_: run(do_apply))
    restore_btn.connect("clicked", lambda *_: run(lambda t: restore(t, log)))

    win.show_all()
    Gtk.main()


if __name__ == "__main__":
    args = sys.argv[1:]
    if "--preview" in args:
        kind = args[args.index("--preview") + 1] if len(args) > args.index("--preview") + 1 else "gtk3"
        if kind == "gtk4":
            preview_gtk4()
        else:
            preview_gtk3(handy=(kind == "handy"))
        sys.exit(0)
    theme = next((a for a in args if not a.startswith("--") and os.path.isdir(a)), DEFAULT_THEME)
    if "--apply" in args:
        s = load_settings()
        accent = s["accent"]
        if "--accent" in args:
            v = args[args.index("--accent") + 1]
            accent = dict((n.lower(), c) for n, c in ACCENTS).get(v.lower(), v)
            if not re.fullmatch(r"#[0-9a-fA-F]{6}", accent):
                sys.exit(f"Unknown accent: {v}")
        opts = dict(s["options"])
        if "--no-restart" in args:
            opts["restart"] = False
        apply(theme, opts, accent)
    elif "--restore" in args:
        restore(theme)
    else:
        run_gui()
